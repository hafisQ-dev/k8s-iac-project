Dusty Rose ---
- name: AWS Free Tier Kubernetes Node Hazırlık Şablonu
  hosts: k8s_cluster
  become: true
  tasks:

    # --- 1. ADIM: AWS Free Tier İçin Swap Dosyası (2GB) ---
    - name: 2GB Swap dosyası oluştur (Free Tier kilitlenmelerini önlemek için)
      ansible.builtin.command: fallocate -l 2G /swapfile
      args:
        creates: /swapfile

    - name: Swap dosyası izinlerini sadece root yap
      ansible.builtin.file:
        path: /swapfile
        mode: '0600'

    - name: Dosyayı swap alanına çevir
      ansible.builtin.command: mkswap /swapfile
      register: mkswap_result
      changed_when: mkswap_result.rc == 0
      failed_when: false

    - name: Swap alanını aktif et
      ansible.builtin.command: swapon /swapfile
      register: swapon_result
      changed_when: swapon_result.rc == 0
      failed_when: false

    - name: Swap alanını /etc/fstab dosyasına kalıcı ekle
      ansible.builtin.mount:
        path: none
        src: /swapfile
        fstype: swap
        opts: sw
        state: present

    # --- 2. ADIM: Kubernetes Kernel Modülleri ---
    - name: Kernel modül konfigürasyon dosyasını oluştur
      ansible.builtin.copy:
        dest: /etc/modules-load.d/k8s.conf
        content: |
          overlay
          br_netfilter
        mode: '0644'

    - name: Kernel modüllerini yükle
      ansible.builtin.command: "modprobe {{ item }}"
      loop:
        - overlay
        - br_netfilter
      changed_when: false

    # --- 3. ADIM: Sysctl Ağ Ayarları (IP Forwarding & Bridge) ---
    - name: Kubernetes sysctl konfigürasyon dosyasını oluştur
      ansible.builtin.copy:
        dest: /etc/sysctl.d/k8s.conf
        content: |
          net.bridge.bridge-nf-call-iptables  = 1
          net.bridge.bridge-nf-call-ip6tables = 1
          net.ipv4.ip_forward                 = 1
        mode: '0644'

    - name: Sysctl parametrelerini canlı sisteme uygula
      ansible.builtin.command: sysctl --system
      changed_when: false
